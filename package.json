{
  "name": "dsh-switchboard",
  "description": "Switchboard (掌上指挥台) for DeepSeek Harness: command Agents from Telegram and Feishu bots — tasks, streamed replies, approvals, questions, notices, files, and voice.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "telegram",
    "feishu",
    "lark",
    "bot",
    "chatops",
    "agent",
    "remote-control",
    "掌上指挥台"
  ],
  "version": "0.5.15",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heavenJiang/dsh-switchboard.git"
  },
  "homepage": "https://github.com/heavenJiang/dsh-switchboard#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "docs/*.md",
    "README.md",
    "README.zh.md",
    "lib/index.js",
    "lib/client.js",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "author": "heavenJiang",
  "engines": {
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/cordis-plugin-loader": ">=1.0.0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-client-file-upload": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-experimental-speech-to-text": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-permission-presets": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-user-approval": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-workspace": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/dsh-workspace-changes": ">=0.2.0-0 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "qrcode-generator": "2.0.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-experimental-speech-to-text": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace-changes": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    }
  },
  "bugs": {
    "url": "https://github.com/heavenJiang/dsh-switchboard/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
