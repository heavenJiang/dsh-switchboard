{
  // Type-checks against a sibling deepseek-harness checkout (../deepseek-harness,
  // built with `pnpm build`). At runtime every @deepseek-ai/* import resolves to
  // the running dsh installation through peerDependencies.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "lib/types",
    "rootDir": "src",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["../deepseek-harness/vendor/cordis"],
      "@deepseek-ai/cordis-plugin-loader": ["../deepseek-harness/vendor/loader"],
      "@deepseek-ai/schemastery": ["../deepseek-harness/vendor/schemastery"],
      "@deepseek-ai/dsh-api-session-controller": ["../deepseek-harness/packages/api/session-controller"],
      "@deepseek-ai/dsh-client-file-upload": ["../deepseek-harness/packages/client/file-upload"],
      "@deepseek-ai/dsh-agent": ["../deepseek-harness/packages/core/agent"],
      "@deepseek-ai/dsh-permission-presets": ["../deepseek-harness/packages/interaction/permission-presets"],
      "@deepseek-ai/dsh-session": ["../deepseek-harness/packages/core/session"],
      "@deepseek-ai/dsh-user-approval": ["../deepseek-harness/packages/interaction/user-approval"],
      "@deepseek-ai/dsh-client-ui-primitives": ["../deepseek-harness/packages/client/ui-primitives"],
      "@deepseek-ai/dsh-client-ui-slots": ["../deepseek-harness/packages/client/ui-slots"],
      "@deepseek-ai/dsh-client-locale/client": ["../deepseek-harness/packages/client/locale/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-settings/client": ["../deepseek-harness/packages/client/ui-settings/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-renderer/client": ["../deepseek-harness/packages/client/ui-renderer/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-plugin-manager/client": ["../deepseek-harness/packages/client/ui-plugin-manager/lib/types/client/index.d.ts"],
      "react": ["../deepseek-harness/node_modules/@types/react"],
      "react/jsx-runtime": ["../deepseek-harness/node_modules/@types/react/jsx-runtime.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/client"]
}
